#!/bin/sh
# 커밋 제목이 Conventional Commits 형식인지 본다(CLAUDE.md 커밋 규칙, research R19).
# 정규식: ^(feat|fix|refactor|perf|test|docs|style|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: \S.{0,70}$
# git이 만든 병합·되돌리기 메시지는 통과시킨다.
# 주석(#)과 빈 줄을 건너뛴 첫 줄을 제목으로 본다.

subject=$(grep -v '^#' "$1" | grep -v '^[[:space:]]*$' | head -n 1)

case "$subject" in
  "Merge "*|"Revert \""*) exit 0 ;;
esac

fail() {
  cat >&2 <<MSG
커밋 제목이 형식에 맞지 않아요: $subject
($1)

  <type>(<scope>)!: <제목>
  type: feat, fix, refactor, perf, test, docs, style, build, ci, chore, revert
  예: feat(write): 사진 여러 장 한 번에 고르기

자세한 규칙은 CLAUDE.md "커밋 규칙"에 있어요.
MSG
  exit 1
}

prefix='^(feat|fix|refactor|perf|test|docs|style|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^[:space:]]'
printf '%s\n' "$subject" | LC_ALL=C grep -Eq "$prefix" || fail "type과 콜론 뒤 제목을 확인해 주세요"

# 로캘과 상관없이 글자 수를 세려고 UTF-8 이어지는 바이트를 빼고 센다.
description=${subject#*: }
length=$(printf '%s' "$description" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')
[ "$length" -le 71 ] || fail "제목이 ${length}자예요. 71자까지 써 주세요"
exit 0
