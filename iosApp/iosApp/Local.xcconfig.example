// 이 파일을 같은 폴더의 Local.xcconfig로 복사하고 클라우드 콘솔 "1일 1일기 iOS" 클라이언트 값을 넣는다(Local.xcconfig는 저장소에 올리지 않는다).
GID_CLIENT_ID = 000000000000-xxxxxxxx.apps.googleusercontent.com
GID_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-xxxxxxxx
// AdMob iOS 앱 ID와 광고 단위. xcconfig는 //를 주석으로 읽어 슬래시를 $()로 끊는다.
ADMOB_APP_ID = ca-app-pub-0000000000000000~0000000000
ADMOB_NATIVE = ca-app-pub-0000000000000000/$()0000000000
ADMOB_INTERSTITIAL = ca-app-pub-0000000000000000/$()0000000000
ADMOB_REWARDED = ca-app-pub-0000000000000000/$()0000000000
// RevenueCat 프로젝트의 App Store 앱 공개 키(appl_로 시작)
REVENUECAT_IOS = appl_xxxxxxxxxxxxxxxxxxxxxxxx
