<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 개발 빌드는 강제 종료 훅을 끼우는 앱 클래스를 쓴다(T049). -->
    <application
        android:name=".debug.DebugApplication"
        tools:replace="android:name">
        <!-- 개발 빌드에만 있다. 아직 들어갈 길이 없는 화면을 에뮬레이터에서 띄워 본다(ScreenCatalogActivity). -->
        <activity
            android:name=".debug.ScreenCatalogActivity"
            android:exported="true" />
        <!-- 개발자 모드. 개발 빌드에만 아이콘이 하나 더 생긴다. 출시 빌드에는 없다. -->
        <activity
            android:name=".debug.DevModeActivity"
            android:exported="true"
            android:label="1일 1일기 개발">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
