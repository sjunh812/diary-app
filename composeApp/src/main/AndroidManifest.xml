<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 매일 알림(스펙 001 FR-022). 옛 앱도 선언했던 권한이라 업데이트 뒤에도 허락이 이어진다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 일기·사진·설정·잠금은 시스템 백업과 기기 간 이전으로 나가지 않는다(헌법 II, 스펙 001 research O5).
         Android 12부터는 allowBackup="false"여도 기기 간 이전이 돌아서 규칙 파일로도 모두 뺀다. -->
    <application
        android:name=".DiaryApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Diary">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Diary.Starting"
            android:windowSoftInputMode="adjustResize" />
        <!-- 런처는 옛 앱(1.7.x)의 이름 .SplashActivity를 그대로 쓴다. 이름이 바뀌면 홈 화면 아이콘과 바로가기가 깨질 수 있다(research R14). -->
        <activity-alias
            android:name=".SplashActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- 매일 알림 수신기. 옛 앱의 이름(.helper.AlarmReceiver) 그대로라 업데이트 전에 걸어 둔 예약도 여기로 온다(research R15). -->
        <receiver
            android:name=".helper.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
        <!-- 고쳐 받기 문의 묶음(files/migration/support)만 메일 앱에 읽기 권한으로 넘긴다(FR-010a). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.support"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/support_paths" />
        </provider>
    </application>
</manifest>
