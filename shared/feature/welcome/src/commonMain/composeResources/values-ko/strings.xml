<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="letter_arrived">편지가 도착했어요</string>
    <string name="letter_open">편지 열기</string>
    <string name="letter_title">개발자의 편지</string>
    <string name="letter_hello">안녕하세요,\n1일 1일기 개발자입니다 👋</string>
    <string name="letter_short">사용하시면서 불편한 점도 많으셨을 거라 생각합니다. 그래서 앱을 **처음부터 새롭게** 만들었습니다. 이제 **사진까지 함께 백업**할 수 있고, 유용한 기능도 더했습니다.\n\n꾸준히 업데이트하기 위해 광고와 유료 기능을 추가하게 되었습니다. 대신 아래 두 가지는 약속드리겠습니다.</string>
    <string name="letter_sign">From. 서주냥</string>
    <string name="letter_start">계속하기</string>
    <string name="onboarding_backup_title">사진까지 백업해요</string>
    <string name="onboarding_backup_body">휴대폰을 바꿔도 일기와 사진이 그대로예요.\n내 구글 드라이브에만 올려요.</string>
    <string name="onboarding_backup_action">자동 백업 켜기</string>
    <string name="onboarding_fresh_title">이렇게 달라졌어요</string>
    <string name="onboarding_write_title">하루 한 줄이면 충분해요</string>
    <string name="onboarding_write_body">기분을 고르고 몇 줄만 남겨 보세요.</string>
    <string name="onboarding_own_title">일기는 내 드라이브에만</string>
    <string name="onboarding_own_body">회원가입 없이 내 구글 드라이브에\n사진까지 백업해요.</string>
    <string name="onboarding_next">다음</string>
    <string name="onboarding_start">시작하기</string>
    <string name="onboarding_skip">건너뛰기</string>
    <string name="onboarding_later">나중에</string>
    <plurals name="letter_moved"><item quantity="other">그동안 일기 **%1$s편**을 남겨 주셨습니다.\n부족한 앱을 꾸준히 써 주셔서 정말 감사드립니다.</item></plurals>
    <string name="letter_promise_free">쓰시던 기능은 계속 무료입니다</string>
    <string name="letter_promise_ads">쓰기와 상세 화면에는 광고가 없습니다</string>
    <string name="letter_close">앞으로도 잘 부탁드립니다 🙇‍♂️</string>
    <string name="onboarding_style_title">글자를 꾸밀 수 있어요</string>
    <string name="onboarding_style_body">굵게, 글자색, 형광펜, 목록을 써 보세요.</string>
    <string name="onboarding_trash_title">실수로 삭제해도 괜찮아요</string>
    <string name="onboarding_trash_body">휴지통에서 30일 동안 복원할 수 있어요.</string>
    <string name="onboarding_wide_title">넓은 화면에서 더 쉽게</string>
    <string name="onboarding_wide_body">태블릿에서는 목록과 일기를 나란히 봐요.</string>
    <string name="onboarding_plus_title">Plus로 더 넉넉하게</string>
    <string name="onboarding_plus_body">광고 없이, 사진 30장, 체크리스트, 고급 통계까지 써요.</string>
    <string name="letter_to">To. 1일 1일기 사용자분들께</string>
</resources>
