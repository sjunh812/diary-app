    <string name="lock_settings_relock_body">다른 앱을 쓰다가 돌아왔을 때 고른 시간이 지났으면 다시 잠가요.</string>
    <string name="relock_immediately">바로</string>
    <string name="relock_one_minute">1분 뒤</string>
